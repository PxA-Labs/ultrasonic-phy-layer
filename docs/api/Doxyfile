# Doxygen configuration for the public C API reference.
# Run from the repository root:  doxygen docs/api/Doxyfile
# Output: docs/api/c/html/ (gitignored; generated in .github/workflows/docs.yml
# before `mkdocs build`, so the site links to it).

PROJECT_NAME           = "Soundwave C API"
PROJECT_BRIEF          = "Public C ABI of libsoundwave (soundwave_api.h)"
OUTPUT_DIRECTORY       = docs/api/c
HTML_OUTPUT            = html
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = native/include
INPUT                  = native/include/soundwave_api.h \
                         native/include/soundwave/types.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
SOURCE_BROWSER         = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = SW_API=
SEARCHENGINE           = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
HAVE_DOT               = NO
