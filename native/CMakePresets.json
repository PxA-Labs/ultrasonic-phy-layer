{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default configuration",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Config",
      "description": "Debug build with symbols",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-O0 -g"
      }
    },
    {
      "name": "release",
      "displayName": "Release Config",
      "description": "Release build with optimizations",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-O2"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan Config",
      "description": "Debug build with AddressSanitizer (+LeakSanitizer on Linux)",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SW_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UBSan Config",
      "description": "Debug build with UndefinedBehaviorSanitizer (fatal)",
      "binaryDir": "${sourceDir}/build/ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SW_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer Config",
      "description": "libFuzzer harnesses with ASan+UBSan (requires LLVM clang)",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SW_BUILD_TESTS": "OFF",
        "SW_ENABLE_FUZZER": "ON",
        "SW_ENABLE_ASAN": "ON",
        "SW_ENABLE_UBSAN": "ON"
      }
    }
  ]
}
